model Hospital {
  id               String   @id @default(uuid())
  name             String
  address          String
  phone            String
  emergencyContact String?
  latitude         Float?
  longitude        Float?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  emergencyRequests EmergencyRequest[]

  @@map("hospitals")
}